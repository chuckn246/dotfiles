# Fail on HTTP errors (4xx/5xx) instead of silently succeeding.
fail-with-body

# Follow redirects.
location

# Preserve useful information across redirects.
referer = ";auto"

# Connection and transfer timeouts.
connect-timeout = 30
max-time = 300

# Retry transient failures.
retry = 3
retry-delay = 5
retry-max-time = 60

# Show errors but keep normal output usable.
show-error

# Include the remote filename when using -O.
remote-header-name

# Use compressed responses when supported.
compressed

# IPv4 first if IPv6 causes connectivity problems.
# ipv4

# Keep a persistent connection cache.
keepalive-time = 60

# Security: don't read credentials from random .netrc files.
# netrc

# Better TLS defaults (usually already the default).
tlsv1.2
